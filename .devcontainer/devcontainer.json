{
  "name": "Rodem Namu cloud preview",
  "dockerComposeFile": [
    "../compose.yaml",
    "compose.yaml"
  ],
  "service": "web",
  "workspaceFolder": "/app",
  "initializeCommand": "python3 scripts/configure.py",
  "postCreateCommand": "php scripts/init.php",
  "postStartCommand": "sh scripts/cloud-start.sh",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Rodem Namu kimchi app",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "shutdownAction": "stopCompose",
  "overrideCommand": true
}
